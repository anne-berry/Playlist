

@model string[]




@{
    ViewData["Title"] = "My Playlist";
}

<div class="container mt-4">
    <h1>My Playlist</h1>

    <p>Here are my six favourite songs:</p>

    <ol>
        @for (int i = 0; i < Model.Length; i++)
        {
            <li class="mb-3">
                <strong>@Model[i]</strong>

                <a asp-controller="Playlist"
                   asp-action="Track"
                   asp-route-number="@(i + 1)"
                   class="btn btn-primary btn-sm ms-2">
                    Play Song
                </a>
            </li>
        }
    </ol>

    <a asp-controller="Playlist"
       asp-action="Find"
       class="btn btn-success">
        Find a Song
    </a>
</div>
