@{
}


@{
    ViewData["Title"] = "Now Playing";
}

<div class="container mt-4">
    <h1>Now Playing</h1>

    <h3>Track @ViewBag.Number: @ViewBag.Song</h3>

    <div class="mt-4">
        @if (ViewBag.Previous > 0)
        {
            <a asp-controller="Playlist"
               asp-action="Track"
               asp-route-number="@ViewBag.Previous"
               class="btn btn-primary">
                Previous
            </a>
        }

        @if (ViewBag.Next > 0)
        {
            <a asp-controller="Playlist"
               asp-action="Track"
               asp-route-number="@ViewBag.Next"
               class="btn btn-primary">
                Next
            </a>
        }
    </div>

    <div class="mt-3">
        <a asp-controller="Playlist"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Playlist
        </a>
    </div>
</div>
